{
  "name": "@repo/attendance",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.ts",
      "development": "./src/infrastructure/index.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "development": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import tsx --test \"src/**/*.test.ts\"",
    "test:small": "node --conditions=development --import tsx --test \"src/**/*.small.test.ts\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "4.10.2",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@types/pg": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "@repo/users": "workspace:*",
    "@repo/platform": "workspace:*",
    "pg": "catalog:"
  }
}
