{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "resolvePackageJsonImports": true
  },
  "include": ["package.json", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
