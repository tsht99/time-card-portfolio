{
  "$schema": "https://turborepo.com/schema.json",
  "cacheMaxSize": "1GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "NEXT_PUBLIC_LIFF_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "LINE_CHANNEL_ID",
        "SESSION_TTL_HOURS",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "web#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:small": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:medium": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
