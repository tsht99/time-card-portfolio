{
  "name": "@repo/users",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.ts",
      "development": "./src/infrastructure/index.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "development": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "development": "./src/internal.ts",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test:small": "node --import tsx --test \"src/**/*.small.test.ts\"",
    "test:medium": "medium-test \"src/**/*.medium.test.ts\""
  },
  "dependencies": {
    "@repo/postgres": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "msw": "3.0.3",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@repo/medium-test-runner": "workspace:*",
    "@repo/test-support": "workspace:*"
  }
}
