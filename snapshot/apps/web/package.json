{
  "name": "web",
  "private": true,
  "type": "module",
  "exports": {
    "./test-support/browser/environment": "./test-support/browser/environment.ts",
    "./test-support/browser/*": "./test-support/browser/*.ts"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:small": "node --conditions=development --test test-support/browser/prepare.contract.test.mjs && vitest run --project small",
    "test:medium": "vitest run --project storybook-browser && node --conditions=development ./test-support/browser/prepare.ts && WEB_TEST_RUNTIME=production playwright test",
    "test:medium:dev": "WEB_TEST_RUNTIME=development node --conditions=development ./test-support/browser/prepare.ts && WEB_TEST_RUNTIME=development playwright test",
    "test-support:browser:webserver": "node --conditions=development ./test-support/browser/webserver.ts",
    "typecheck": "rm -rf .next/dev/types && next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@line/liff": "2.31.2",
    "@repo/attendance": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/payroll": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/users": "workspace:*",
    "@sentry/nextjs": "11.6.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-safe-action": "8.7.3",
    "nuqs": "2.10.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.89.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "catalog:",
    "@repo/postgres": "workspace:*",
    "@repo/test-support": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "30.1.2",
    "pg": "catalog:",
    "playwright": "1.64.0",
    "storybook": "10.6.1",
    "typescript": "catalog:frontend-tooling",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  }
}
