{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "overrides": [
    {
      "includes": ["modules/users/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@repo/contracts": "Domain は共有 Web contract に依存しません。",
                  "@repo/db": "Domain は DB に依存しません。",
                  "@repo/users/schema": "Domain は Users schema に依存しません。",
                  "@repo/postgres": "Domain は PostgreSQL 接続 package に依存しません。",
                  "@repo/ui": "Domain は UI に依存しません。",
                  "next": "Domain は Next.js に依存しません。",
                  "drizzle-orm": "Domain は ORM に依存しません。",
                  "pg": "Domain は PostgreSQL driver に依存しません。",
                  "@neondatabase/serverless": "Domain は PostgreSQL driver に依存しません。"
                },
                "patterns": [
                  {
                    "group": [
                      "@repo/{contracts,db,postgres,ui}/**",
                      "@repo/{users,attendance,payroll}",
                      "@repo/{users,attendance,payroll}/{application,infrastructure}/**",
                      "**/{contracts,db,line,postgres,server,ui}/**",
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/schema",
                      "**/schema/**",
                      "next/**",
                      "drizzle-orm/**"
                    ],
                    "message": "Domain は外側の層と技術基盤に依存しません。"
                  },
                  {
                    "group": [
                      "@repo/attendance/**",
                      "**/attendance/**",
                      "@repo/payroll/**",
                      "**/payroll/**"
                    ],
                    "message": "別の業務モジュールの内部 subpath に直接依存しません。"
                  }
                ]
              }
            }
          }
        }
      }
    },
