{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "parser": {
      "vue": true
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["**"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": false
          }
        }
      }
    }
  },
  "extends": [
    "./config/biome/repository-and-package-rules.json",
    "./config/biome/module-rules.json",
    "./config/biome/web-and-db-rules.json",
    "./config/biome/exceptions-and-schema-rules.json"
  ]
}
