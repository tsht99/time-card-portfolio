# Local の DATABASE_URL / DATABASE_ENVIRONMENT は repository root の .env.local を使用する。
# この package 内の .env.local は読み込まない。
# 以下は Preview / Production の server runtime connection 値の例。実値は対象環境の secret 管理へ設定する。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Preview / Production の migration・Projection rebuild 用 direct connection
# 実際の接続文字列は secret として管理し、DATABASE_URL へ fallback しない
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Preview / Production maintenance operation が接続先確認に使う非 credential の identity
DATABASE_MAINTENANCE_EXPECTED_HOST="DIRECT_HOST"
DATABASE_MAINTENANCE_EXPECTED_DATABASE="DATABASE"
