# dev:web:liff、db:migrate、Drizzle schema/migration generation 用の共通 Local 設定。
# 実値は root .env.local に設定し、このファイル自体は Git 管理する。
DATABASE_URL=postgresql://user:password@localhost:5432/timecard
DATABASE_ENVIRONMENT=local
LINE_CHANNEL_ID=your-line-channel-id
NEXT_PUBLIC_LIFF_ID=your-liff-id
NEXT_PUBLIC_HELP_URL=https://help.example.com
