{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "parser": {
      "vue": true
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["**"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/public/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/payroll/**",
        "!packages/payroll/src/schema/hourly-wage-rates.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@repo/contracts": {
                    "message": "Domain は契約を定義する層に依存せず、ドメインモデルを独立して保ちます。"
                  },
                  "@repo/db": {
                    "message": "Domain は永続化の詳細に依存せず、ドメインモデルを独立して保ちます。"
                  },
                  "@repo/platform": {
                    "message": "Domain は共通技術基盤に依存せず、ドメインモデルを独立して保ちます。"
                  },
                  "@repo/server": {
                    "message": "Domain はアプリケーション実行基盤に依存せず、ドメインモデルを独立して保ちます。"
                  },
                  "@repo/ui": {
                    "message": "Domain は表示層に依存せず、ドメインモデルを独立して保ちます。"
                  },
                  "@repo/users/infrastructure": {
                    "message": "Payroll は Users Infrastructure を直接参照しません。"
                  },
                  "@repo/users/schema": {
                    "message": "Payroll は Users schema を直接参照しません。"
                  },
                  "@repo/payroll/infrastructure": {
                    "message": "Domain は Infrastructure に依存しません。"
                  },
                  "@repo/payroll/delivery": {
                    "message": "Domain は Delivery に依存しません。"
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@repo/contracts/**",
                      "@repo/db/**",
                      "@repo/platform/**",
                      "@repo/server/**",
                      "@repo/ui/**",
                      "**/platform/**",
                      "@repo/users/{application,domain,infrastructure,delivery}/**",
                      "@repo/users",
                      "**/users/src/**"
                    ],
                    "message": "Domain は他の workspace package の subpath に依存せず、ドメインモデルを独立して保ちます。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/attendance/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
